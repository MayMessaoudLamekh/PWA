# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Replace <username>, <password> and <cluster> and keep the database name (/smartcar).
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartcar?retryWrites=true&w=majority"

# Used to sign the session cookie. Generate your own with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
